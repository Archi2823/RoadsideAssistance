<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Towing Assistance"
            android:textColor="#172B4D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="Enter your vehicle details and pickup location."
            android:textColor="#65728A"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle type *"
            android:textColor="#172B4D"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTowingVehicleType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#2457C5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Towing issue *"
            android:textColor="#172B4D"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTowingIssue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#2457C5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pickup location *"
            android:textColor="#172B4D"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPickupLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#2457C5"
            android:hint="Enter current location / landmark"
            android:inputType="textCapSentences|textPostalAddress"
            android:minHeight="52dp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destination (optional)"
            android:textColor="#172B4D"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTowingDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#2457C5"
            android:hint="Garage or preferred destination"
            android:inputType="textCapSentences|textPostalAddress"
            android:minHeight="52dp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Additional details (optional)"
            android:textColor="#172B4D"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTowingDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#2457C5"
            android:gravity="top|start"
            android:hint="Describe the problem or add landmarks"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="100dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSubmitTowingRequest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#2457C5"
            android:text="Submit Towing Request"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>