<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Screen Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request Roadside Assistance"
            android:textColor="#172B4D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Tell us about your vehicle and assistance needs."
            android:textColor="#65748B"
            android:textSize="15sp" />

        <!-- Vehicle Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle Type *"
            android:textColor="#172B4D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spVehicleType"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="#2457C5" />

        <!-- Vehicle Issue -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Vehicle Issue *"
            android:textColor="#172B4D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spBatteryIssue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="#2457C5" />

        <!-- Fuel Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Fuel Type *"
            android:textColor="#172B4D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spFuelType"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="#2457C5" />

        <!-- Fuel Quantity -->
        <TextView
            android:id="@+id/tvFuelQuantityLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Fuel Quantity (litres) *"
            android:textColor="#172B4D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spFuelQuantity"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="#2457C5" />

        <!-- Dynamic Estimated Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#E8F0FE">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Estimated Price"
                android:textColor="#172B4D"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEstimatedPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Select fuel type and quantity"
                android:textColor="#2457C5"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPriceNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Illustrative rates only. Final charges may vary."
                android:textColor="#65748B"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Location -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your Location *"
            android:textColor="#172B4D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBatteryLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2457C5"
            android:hint="Enter address or nearby landmark"
            android:inputType="textPostalAddress"
            android:padding="14dp"
            android:textColor="#172B4D"
            android:textColorHint="#8995A8" />

        <!-- Additional Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Additional Details (Optional)"
            android:textColor="#172B4D"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBatteryDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="110dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2457C5"
            android:gravity="top|start"
            android:hint="Describe your vehicle problem, symptoms or assistance needs..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:textColor="#172B4D"
            android:textColorHint="#8995A8" />

        <!-- Validation / Status Message -->
        <TextView
            android:id="@+id/tvBatteryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#C62828"
            android:textSize="14sp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitBatteryRequest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#2457C5"
            android:text="Submit Request"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="You can edit or cancel your request before a technician is assigned."
            android:textColor="#65748B"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
