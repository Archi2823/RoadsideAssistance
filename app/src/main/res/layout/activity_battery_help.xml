<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request Battery Help"
            android:textColor="#172B4D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Tell us about your vehicle and battery problem."
            android:textColor="#65748B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle Type"
            android:textColor="#172B4D"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spVehicleType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2457C5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Battery Issue"
            android:textColor="#172B4D"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spBatteryIssue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2457C5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Your Location"
            android:textColor="#172B4D"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBatteryLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:hint="Enter address or nearby landmark"
            android:inputType="textPostalAddress"
            android:padding="14dp"
            android:backgroundTint="#2457C5" />

        <EditText
            android:id="@+id/etBatteryDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:layout_marginTop="16dp"
            android:gravity="top"
            android:hint="Additional details (optional)"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:backgroundTint="#2457C5" />

        <TextView
            android:id="@+id/tvBatteryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#C62828"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSubmitBatteryRequest"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Submit Request"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#2457C5"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
