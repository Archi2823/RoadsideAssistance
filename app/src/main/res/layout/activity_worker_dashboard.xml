<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F6FB"
    android:padding="18dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="18dp">

        <!-- TITLE AND WELCOME -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROADSIDE ASSISTANCE"
                android:textColor="#6B7D93"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Welcome, Worker"
                android:textColor="#173B6C"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manage your service requests"
                android:textColor="#718096"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- PROFILE ICON -->
        <ImageButton
            android:id="@+id/btnWorkerProfile"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/worker_profile_icon_bg"
            android:contentDescription="My Profile"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_person_profile"
            android:tint="#173B6C" />

        <!-- LOGOUT -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#E4ECF7"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#173B6C"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- DASHBOARD OVERVIEW -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Work Overview"
        android:textColor="#173B6C"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- COUNTERS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- ASSIGNED -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="#E4EEFF"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvAssignedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#2563EB"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Assigned"
                android:textColor="#31547F"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- IN PROGRESS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:background="#FFF1DB"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvProgressCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#C47A16"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="In Progress"
                android:textColor="#805719"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- COMPLETED -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="#E1F4E9"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvCompletedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#18834C"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Completed"
                android:textColor="#276749"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- SERVICE CHARGES BUTTON -->
    <Button
        android:id="@+id/btnServiceCharges"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2563EB"
        android:text="₹  Manage Service Charges"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- REQUEST CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="22dp"
        android:fillViewport="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ASSIGNED REQUESTS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="New Assigned Requests"
                    android:textColor="#173B6C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Requests waiting for you to start"
                    android:textColor="#8492A6"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/assignedRequestsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- IN PROGRESS REQUESTS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Work In Progress"
                    android:textColor="#173B6C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Service requests currently being handled"
                    android:textColor="#8492A6"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/progressRequestsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- COMPLETED REQUESTS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Completed Requests"
                    android:textColor="#173B6C"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your successfully completed services"
                    android:textColor="#8492A6"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/completedRequestsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

            <!-- EMPTY STATE -->
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:padding="20dp"
                android:text="No service requests assigned to you yet."
                android:textColor="#7B8794"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
