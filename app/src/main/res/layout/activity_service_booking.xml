<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <Button
            android:id="@+id/btnBookingBack"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:backgroundTint="#E5EDFA"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="#173B6C" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Book Your Service"
            android:textColor="#173B6C"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter your details and choose a preferred appointment."
            android:textColor="#718096"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Selected Service"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_service_card"
            android:padding="16dp"
            android:text="General Service"
            android:textColor="#2457C5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Vehicle Type *"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spBookingVehicleType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_service_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Preferred Date *"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#E8F0FF"
            android:text="Select Booking Date"
            android:textAllCaps="false"
            android:textColor="#173B6C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSelectedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No date selected"
            android:textColor="#2457C5"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Preferred Time *"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelectTime"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#E8F6EF"
            android:text="Select Booking Time"
            android:textAllCaps="false"
            android:textColor="#176B4D"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSelectedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="No time selected"
            android:textColor="#16845D"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Service Location *"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBookingLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_service_card"
            android:hint="Enter your complete location"
            android:inputType="textPostalAddress"
            android:minHeight="54dp"
            android:padding="14dp"
            android:textColor="#173B6C"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Additional Details (Optional)"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBookingDescription"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_service_card"
            android:gravity="top"
            android:hint="Describe any specific vehicle problem or service requirement"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp"
            android:textColor="#173B6C"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <!-- Notes for the mechanic -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Notes for Mechanic (Optional)"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBookingNotes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_service_card"
            android:gravity="top"
            android:hint="Example: Please check brakes, tyre pressure or engine noise..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:padding="14dp"
            android:textColor="#173B6C"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvBookingMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#B8323C"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConfirmBooking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#2457C5"
            android:text="Confirm Booking"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
