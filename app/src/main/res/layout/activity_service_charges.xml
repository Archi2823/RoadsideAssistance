<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnChargesBack"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:backgroundTint="#E5EDFA"
            android:text="← Back"
            android:textAllCaps="false"
            android:textColor="#173B6C"
            android:textSize="14sp" />

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Service Charges"
            android:textColor="#173B6C"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Manage pricing for vehicle maintenance services."
            android:textColor="#718096"
            android:textSize="14sp" />

        <!-- Vehicle Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Vehicle Type *"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spChargesVehicleType"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_service_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- General Service Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_service_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01  |  GENERAL SERVICE"
                android:textColor="#2457C5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="General Service"
                android:textColor="#173B6C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Routine maintenance and basic vehicle servicing."
                android:textColor="#718096"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Service Charge (₹) *"
                android:textColor="#344563"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etGeneralServiceCharge"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_service_card"
                android:hint="Enter general service price"
                android:inputType="numberDecimal"
                android:maxLength="10"
                android:padding="14dp"
                android:textColor="#173B6C"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Annual Service Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_service_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02  |  ANNUAL SERVICE"
                android:textColor="#16845D"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Annual Service"
                android:textColor="#173B6C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Periodic maintenance and comprehensive checks."
                android:textColor="#718096"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Service Charge (₹) *"
                android:textColor="#344563"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAnnualServiceCharge"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_service_card"
                android:hint="Enter annual service price"
                android:inputType="numberDecimal"
                android:maxLength="10"
                android:padding="14dp"
                android:textColor="#173B6C"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Inspection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_service_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03  |  INSPECTION"
                android:textColor="#9A6A24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Vehicle Inspection"
                android:textColor="#173B6C"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Brakes, tyres, lights and safety component checks."
                android:textColor="#718096"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Inspection Charge (₹) *"
                android:textColor="#344563"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etInspectionCharge"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_service_card"
                android:hint="Enter inspection price"
                android:inputType="numberDecimal"
                android:maxLength="10"
                android:padding="14dp"
                android:textColor="#173B6C"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Optional Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Additional Information (Optional)"
            android:textColor="#344563"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etChargesDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_service_card"
            android:gravity="top"
            android:hint="Add details about service pricing..."
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:padding="14dp"
            android:textColor="#173B6C"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvChargesMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#B8323C"
            android:textSize="13sp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveServiceCharges"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="25dp"
            android:backgroundTint="#2457C5"
            android:text="Save Service Charges"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>